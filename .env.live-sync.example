# 真实同步所需的挂载路径（不含任何密钥）
# 用法：复制本文件为 .env.live-sync，把下面的占位路径改成你本机的实际绝对路径，然后：
#   docker compose --env-file .env.live-sync -f docker-compose.integration.yml --profile live-sync-dingtalk run --rm sync-dingtalk
# 说明：.env.live-sync 已被 .gitignore 忽略（本机专属），本模板入库供参考。
PUBLIC_DATA_LIVE_MANIFEST_PATH=/absolute/path/to/digital-ops/docker/integration/source-manifest.json
PUBLIC_DATA_LIVE_CREDENTIALS_PATH=/absolute/path/to/credentials/source-credentials.json
